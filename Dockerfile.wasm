FROM emscripten/emsdk:5.0.5

# Linux Packages
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-setuptools \
        git \
        rsync \
        ccache \
    && rm -rf /var/lib/apt/lists/*

# Python Packages
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages \
        future \
        lxml \
        pymavlink \
        MAVProxy \
        pexpect \
        geocoder \
        empy==3.3.4 \
        dronecan \
        pyserial

# Source tree is bind mounted at /ardupilot
WORKDIR /ardupilot

# Mark the bind mount safe for git
RUN git config --global --add safe.directory /ardupilot

# Cache dir should be mounted from host at runtime (-v .ccache:/root/.ccache).
ENV CC="ccache emcc"
ENV CXX="ccache em++"
ENV AR=emar
ENV NM=emnm
ENV RANLIB=emranlib
ENV CCACHE_MAXSIZE=2G
ENV CCACHE_DIR=/root/.ccache
ENV CCACHE_COMPILERCHECK=content

ENTRYPOINT ["/ardupilot/Tools/wasm/build.sh"]
CMD ["copter"]
